  m_Script: {fileID: 11500000, guid: f6ae310e1d0c4b449a55560ffef3a7d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BriefingVoice
  clip: {fileID: 8300000, guid: 3ed407242e1e78d41b3c8ad174ca5bb0, type: 3}
  cues:
  - start: 0
    text: "\uAC01\uC790 \uD655\uC778\uD574\uC8FC\uC138\uC694."
  - start: 13.55
    text: "\uD0D5\uC218\uC721 \uC9C0\uAE09\uC7AC\uB8CC \uBAA9\uB85D\uC785\uB2C8\uB2E4.
      \uB3FC\uC9C0\uB4F1\uC2EC 200g, \uB2EC\uAC40 1\uAC1C, \uB300\uD30C, \uB2F9\uADFC,
      \uC624\uC774, \uC644\uB450\uCF69, \uBAA9\uC774\uBC84\uC12F, \uC591\uD30C, \uCCAD\uC8FC,
      \uC2DD\uCD08, \uC2DD\uC6A9\uC720, \uC124\uD0D5, \uAC04\uC7A5, \uB179\uB9D0\uAC00\uB8E8\uC785\uB2C8\uB2E4."
  - start: 34.7
    text: "\uB9C8\uD30C\uB450\uBD80 \uC9C0\uAE09\uC7AC\uB8CC \uBAA9\uB85D\uC785\uB2C8\uB2E4.
      \uB450\uBD80 150g, \uB2E4\uC9C4 \uB3FC\uC9C0\uB4F1\uC2EC 50g, \uB9C8\uB298
      2\uCABD, \uC0DD\uAC15, \uB300\uD30C, \uD64D\uACE0\uCD94, \uB450\uBC18\uC7A5,
      \uACE0\uCDA7\uAC00\uB8E8, \uAC04\uC7A5, \uC2DD\uC6A9\uC720, \uCC38\uAE30\uB984,
      \uC124\uD0D5, \uAC80\uC740\uD6C4\uCDA7\uAC00\uB8E8, \uB179\uB9D0\uAC00\uB8E8\uC785\uB2C8\uB2E4."
  - start: 53.15
    text: "\uC7AC\uB8CC\uAC00 \uC5C6\uAC70\uB098 \uC0C1\uD0DC\uAC00 \uC88B\uC9C0
      \uC54A\uB2E4\uBA74 \uB9D0\uD574\uC8FC\uC138\uC694."
  - start: 67.3
    text: "\uBB38\uC81C\uC5C6\uB2E4\uBA74 \uC2DC\uD5D8 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
